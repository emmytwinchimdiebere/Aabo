# Application
APP_ENV=development
BASE_URL=https://replace-with-your-ngrok-domain.ngrok-free.app
DATABASE_PATH=./data/aabo.db
PHONE_HASH_SALT=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173

# Africa's Talking
AT_USERNAME=
AT_API_KEY=

# VoiceBIP
VOICEBIP_API_KEY=
VOICEBIP_SIGNING_SECRET=
VOICEBIP_PREVIOUS_SIGNING_SECRET=
VOICEBIP_API_BASE_URL=https://api.voicebip.com/v1
VOICEBIP_WEBHOOK_MAX_AGE_SECONDS=300
VOICEBIP_REQUEST_TIMEOUT_SECONDS=10
VOICEBIP_ENGLISH_AGENT_ID=
VOICEBIP_YORUBA_AGENT_ID=
VOICEBIP_HAUSA_AGENT_ID=
VOICEBIP_IGBO_AGENT_ID=
SMS_ACKNOWLEDGEMENT_TEXT=Aabo: Report received. A dispatcher will review it. If danger is immediate, contact local emergency services.

# Media ingestion
RECORDING_ALLOWED_HOSTS=api.voicebip.com
RECORDING_MAX_BYTES=10485760
RECORDING_TIMEOUT_SECONDS=15
RECORDING_STORAGE_PATH=./data/recordings

# N-ATLaS / Hugging Face
HF_TOKEN=
NATLAS_BASE_URL=
NATLAS_API_KEY=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models
NATLAS_ENGLISH_MODEL=NCAIR1/NigerianAccentedEnglish
NATLAS_YORUBA_MODEL=NCAIR1/Yoruba-ASR
