# Application
APP_ENV=development
BASE_URL=https://replace-with-your-ngrok-domain.ngrok-free.app
DATABASE_PATH=./data/aabo112.db
PHONE_HASH_SALT=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_RECORDING_ALLOWED_HOSTS=
RECORDING_MAX_BYTES=10485760
RECORDING_TIMEOUT_SECONDS=15

# N-ATLaS / Hugging Face
HF_TOKEN=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models
NATLAS_ENGLISH_MODEL=NCAIR1/NigerianAccentedEnglish
NATLAS_YORUBA_MODEL=NCAIR1/Yoruba-ASR
NATLAS_HAUSA_MODEL=NCAIR1/Hausa-ASR
NATLAS_IGBO_MODEL=NCAIR1/Igbo-ASR
FALLBACK_ASR_MODEL=openai/whisper-large-v3
TRANSCRIPTION_TIMEOUT_SECONDS=45

# NIPOST
NIPOST_BASE_URL=
NIPOST_API_KEY=

# Browser console
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

