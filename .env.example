NATLAS_IGBO_MODEL=NCAIR1/Igbo-ASR
FALLBACK_ASR_MODEL=openai/whisper-large-v3
TRANSCRIPTION_TIMEOUT_SECONDS=45

# NIPOST (reserved for the address-resolution adapter; not active yet)
